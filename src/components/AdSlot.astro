---
export interface Props {
  size: 'leaderboard' | 'rectangle';
}
const { size } = Astro.props;
const minH = size === 'leaderboard' ? 'min-h-[90px]' : 'min-h-[250px]';
---
<div
  class={`w-full ${minH} rounded-lg bg-[var(--color-bg-subtle)] border border-dashed border-[var(--color-border)] flex items-center justify-center my-10 text-[10px] uppercase tracking-widest text-[var(--color-text-subtle)]`}
  aria-hidden="true"
  data-ad-slot={size}
>
  Advertisement
</div>
