---
export interface Props {
  size: 'leaderboard' | 'rectangle';
}
const { size } = Astro.props;
const minH = size === 'leaderboard' ? 'min-h-[90px]' : 'min-h-[250px]';
---
<div
  class={`w-full ${minH} rounded-md bg-[var(--color-bg-subtle)] border border-dashed border-[var(--color-border)] flex items-center justify-center my-8`}
  aria-hidden="true"
  data-ad-slot={size}
>
  <!-- AdSense slot reserved — activated after approval -->
</div>
