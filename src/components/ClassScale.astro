---
export interface Props {
  density?: number | null;
  targetClass?: number | null;
  id?: string;
}
const { density, id = 'class-scale' } = Astro.props;
---
<div class="card p-4" data-density-scale id={id}>
  <div class="flex items-center justify-between mb-2 text-[11px] uppercase tracking-wider text-[var(--color-text-subtle)]">
    <span>Denser · Class 50</span>
    <span>Less dense · Class 500</span>
  </div>
  <svg viewBox="0 0 400 32" width="100%" height="32" class="block" role="img" aria-label="Density scale with marker">
    <defs>
      <linearGradient id={id + '-grad'} x1="0" x2="1">
        <stop offset="0%" stop-color="var(--color-success)"/>
        <stop offset="50%" stop-color="var(--color-warning)"/>
        <stop offset="100%" stop-color="var(--color-error)"/>
      </linearGradient>
    </defs>
    <rect x="0" y="12" width="400" height="8" rx="4" fill={`url(#${id}-grad)`}/>
    <g id={id + '-ticks'} stroke="var(--color-border-strong)" stroke-width="1">
      <line x1="0"   y1="9" x2="0"   y2="23"/>
      <line x1="100" y1="9" x2="100" y2="23"/>
      <line x1="200" y1="9" x2="200" y2="23"/>
      <line x1="300" y1="9" x2="300" y2="23"/>
      <line x1="400" y1="9" x2="400" y2="23"/>
    </g>
    <g id={id + '-marker'} style="display:none">
      <line x1="0" y1="4" x2="0" y2="28" stroke="var(--color-text)" stroke-width="2"/>
      <polygon points="0,0 -5,-6 5,-6" fill="var(--color-text)"/>
    </g>
  </svg>
  <div class="flex justify-between mt-1 text-[10px] text-[var(--color-text-subtle)] tabular">
    <span>50 lb/ft³</span><span>25</span><span>12</span><span>6</span><span>0</span>
  </div>
  <p class="mt-3 text-[13px] text-[var(--color-text-muted)]" data-scale-caption>Enter dimensions and weight to see your density marker.</p>
</div>

<script define:vars={{ id, initialDensity: density ?? null }}>
  const el = document.getElementById(id);
  if (el) {
    const markerG = document.getElementById(id + '-marker');
    const caption = el.querySelector('[data-scale-caption]');

    function xFor(d) {
      const clamped = Math.max(0.5, Math.min(50, d));
      const logMax = Math.log(50);
      const logMin = Math.log(0.5);
      const t = (Math.log(clamped) - logMin) / (logMax - logMin);
      return 400 - t * 400;
    }

    window.updateDensityScale = function (d, cls) {
      if (!isFinite(d) || d <= 0) {
        markerG.style.display = 'none';
        caption.textContent = 'Enter dimensions and weight to see your density marker.';
        return;
      }
      const x = xFor(d);
      markerG.setAttribute('transform', `translate(${x},0)`);
      markerG.style.display = '';
      caption.textContent = `Density ${d.toFixed(2)} lb/ft³ → Class ${cls}`;
    };

    if (initialDensity) window.updateDensityScale(initialDensity);
  }
</script>
