---
// Global language switcher via Google Translate Website Element.
// Zero-cost, ~130 languages, all runs client-side. No API key required.
// Docs: https://cloud.google.com/translate/website-translator
---
<div class="relative flex items-center">
  <span aria-hidden="true" class="pointer-events-none absolute left-2 text-[var(--color-text-muted)]">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 8l6 6"/><path d="M4 14l6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="M22 22l-5-10-5 10"/><path d="M14 18h6"/>
    </svg>
  </span>
  <div id="google_translate_element" aria-label="Translate this page" translate="no" class="notranslate"></div>
</div>

<script is:inline>
  window.googleTranslateElementInit = function () {
    new google.translate.TranslateElement({
      pageLanguage: 'en',
      includedLanguages: 'es,fr,de,it,pt,nl,sv,da,no,fi,pl,ru,uk,tr,ar,he,fa,hi,bn,ur,ta,te,th,vi,id,ms,tl,ja,ko,zh-CN,zh-TW,el,cs,hu,ro,bg,hr,sk,sl,sr,ca,eu,gl,is,af,sw',
      layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
      autoDisplay: false,
    }, 'google_translate_element');
  };
</script>
<script is:inline async src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<style is:global>
  /* Fit Google Translate widget into the Geist aesthetic */
  #google_translate_element {
    display: inline-flex;
    align-items: center;
  }
  #google_translate_element .goog-te-gadget {
    font-family: var(--font-sans) !important;
    font-size: 0 !important;
    color: transparent !important;
  }
  #google_translate_element .goog-te-gadget-simple {
    background: var(--color-bg-subtle) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-sm) !important;
    padding: 4px 8px 4px 24px !important;
    font-size: 12px !important;
    line-height: 1 !important;
    color: var(--color-text-muted) !important;
    cursor: pointer;
    height: 32px;
    display: inline-flex !important;
    align-items: center;
  }
  #google_translate_element .goog-te-gadget-simple:hover {
    border-color: var(--color-border-strong) !important;
    color: var(--color-text) !important;
  }
  #google_translate_element .goog-te-gadget-simple img { display: none !important; }
  #google_translate_element .goog-te-gadget-simple .goog-te-menu-value {
    color: var(--color-text-muted) !important;
    margin: 0 !important;
  }
  #google_translate_element .goog-te-gadget-simple .goog-te-menu-value span {
    color: var(--color-text-muted) !important;
    border: none !important;
  }
  #google_translate_element .goog-te-gadget-simple .goog-te-menu-value span:first-child::before {
    content: 'Translate';
  }
  #google_translate_element .goog-te-gadget-simple .goog-te-menu-value span:first-child {
    font-size: 0 !important;
  }
  #google_translate_element .goog-te-gadget-simple .goog-te-menu-value span:last-child {
    font-size: 12px !important;
  }

  /* Hide the "powered by Google" and top banner that Google injects */
  .goog-te-banner-frame, .skiptranslate iframe.goog-te-banner-frame { display: none !important; }
  body { top: 0 !important; }
  .goog-tooltip, .goog-tooltip:hover { display: none !important; }
  .goog-text-highlight { background: transparent !important; box-shadow: none !important; }
</style>
