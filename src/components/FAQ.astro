---
export interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<section class="mt-16" aria-label="Frequently asked questions">
  <div class="flex items-baseline justify-between mb-6">
    <h2 class="text-2xl font-semibold tracking-tight text-[var(--color-text)]">Frequently Asked Questions</h2>
    <span class="badge">FAQ</span>
  </div>
  <div class="card divide-y divide-[var(--color-border)]">
    {items.map(item => (
      <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
          <span class="text-[15px] font-medium text-[var(--color-text)] leading-snug">{item.q}</span>
          <svg class="mt-1 w-4 h-4 shrink-0 text-[var(--color-text-muted)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="mt-3 text-[14.5px] text-[var(--color-text-muted)] leading-relaxed" set:html={item.a} />
      </details>
    ))}
  </div>
</section>
