---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ClassScale from '../components/ClassScale.astro';

const pageUrl = 'https://freightclassfinder.com/';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Freight Class Calculator",
  "url": pageUrl,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqs = [
  { q: "How do you calculate freight class?",
    a: "Freight class is derived from density: density = weight (lb) ÷ volume (ft³). Volume in ft³ = (length × width × height in inches) ÷ 1728. Look up the density on the standard density-to-class scale (50–500). Higher density → lower class → lower rate. This tool does the lookup automatically." },
  { q: "How do you calculate freight class for multiple pallets?",
    a: "Carriers classify <strong>per line item</strong> on the Bill of Lading, not by shipment aggregate. Enter each pallet as a separate row and read the per-line class. The aggregate density figure below is useful for cube and linear-foot checks, but it is <em>not</em> your billed class." },
  { q: "What is the formula for freight density?",
    a: "Density (lb/ft³) = weight in pounds ÷ volume in cubic feet. Volume in cubic feet = (L × W × H in inches) ÷ 1728. Use the outermost dimensions — pallet footprint plus any overhang, plus pallet deck height. Toggle 'palletized' on each row and the tool applies this automatically." },
  { q: "Why did my carrier reclassify my shipment?",
    a: "Density-based estimates can be overridden if your commodity has a specific NMFC item number, or if the carrier's inspection finds different weight or dimensions than what you declared on the Bill of Lading. Reclassification produces a correction invoice weeks after delivery. This tool gives you the density estimate; your carrier or broker confirms the assigned NMFC item." },
  { q: "How can I lower my freight class?",
    a: "Increase density: pack tighter, use a smaller pallet if the load allows, or consolidate multiple lightweight lines onto one pallet. The breakpoint optimizer below shows, for each line, the smallest change (add weight, or reduce a dimension) that would land you in the next cheaper class." },
  { q: "What is a good freight class?",
    a: "\"Good\" is whatever accurately reflects your actual density. Under-declaring a class produces a correction invoice; over-declaring pays more than you need. The goal is an honest measurement — pallet dimensions, actual weight — that matches what the carrier will observe on its scale and cube meter." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '') }
  }))
};
---
<BaseLayout
  title="Freight Class Calculator – Multi-Pallet, Pallet-Aware, Free"
  description="Free freight class calculator with multi-pallet support, pallet-aware dimensions, and a breakpoint optimizer. Per-line and aggregate density, class 50–500."
  canonical={pageUrl}
  schema={[webAppSchema, faqSchema]}
>
  <SiteHeader current="/" />

  <!-- Hero -->
  <section class="relative border-b border-[var(--color-border)] overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-40 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--color-bg)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-14 pb-10 sm:pt-20 sm:pb-14">
      <div class="flex items-center gap-2 mb-5">
        <span class="badge">v1 · Free</span>
        <span class="text-xs text-[var(--color-text-subtle)]">No signup · Runs in your browser</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[var(--color-text)] max-w-3xl">
        The freight class calculator carriers built for shippers didn't.
      </h1>
      <p class="mt-5 text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed">
        Multi-pallet shipments, pallet-aware dimensions, a breakpoint optimizer that tells you exactly how close you are to a cheaper class — and how close you are to a reclassification invoice.
      </p>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-[var(--color-text-muted)]">
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]"></span>Per-line + aggregate class</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]"></span>Standard pallet presets</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]"></span>Consolidation analysis</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]"></span>Metric / Imperial</span>
      </div>
    </div>
  </section>

  <main id="main" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">

    <!-- Controls bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-1 p-1 rounded-md bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[13px]">
        <label class="cursor-pointer">
          <input type="radio" name="units" value="imperial" class="sr-only peer" checked />
          <span class="inline-flex items-center px-2.5 py-1 rounded peer-checked:bg-[var(--color-bg-elevated)] peer-checked:text-[var(--color-text)] peer-checked:shadow-sm text-[var(--color-text-muted)]">in / lb</span>
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="units" value="metric" class="sr-only peer" />
          <span class="inline-flex items-center px-2.5 py-1 rounded peer-checked:bg-[var(--color-bg-elevated)] peer-checked:text-[var(--color-text)] peer-checked:shadow-sm text-[var(--color-text-muted)]">cm / kg</span>
        </label>
      </div>
      <div class="flex items-center gap-2">
        <button id="copy-summary" type="button" class="btn btn-ghost">Copy summary</button>
        <button id="copy-share" type="button" class="btn btn-secondary">Share</button>
        <button id="print-page" type="button" class="btn btn-ghost">Print</button>
      </div>
    </div>

    <!-- Line items -->
    <div class="card overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-[var(--color-border)]">
        <div class="flex items-center gap-2">
          <h2 class="text-[13px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)]">Shipment lines</h2>
        </div>
        <div class="flex items-center gap-2">
          <button id="clear-lines" type="button" class="btn btn-ghost">Clear</button>
          <button id="add-line" type="button" class="btn btn-primary">+ Add line</button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="lines-table">
          <thead class="text-[11px] uppercase tracking-wider text-[var(--color-text-subtle)]">
            <tr class="border-b border-[var(--color-border)]">
              <th class="text-left px-3 py-2 font-medium">Qty</th>
              <th class="text-left px-3 py-2 font-medium">L <span class="unit-len">in</span></th>
              <th class="text-left px-3 py-2 font-medium">W <span class="unit-len">in</span></th>
              <th class="text-left px-3 py-2 font-medium">H <span class="unit-len">in</span></th>
              <th class="text-left px-3 py-2 font-medium">Wt/unit <span class="unit-wt">lb</span></th>
              <th class="text-left px-3 py-2 font-medium">Pallet</th>
              <th class="text-right px-3 py-2 font-medium">Density</th>
              <th class="text-right px-3 py-2 font-medium">Class</th>
              <th class="px-2 py-2"></th>
            </tr>
          </thead>
          <tbody id="lines-body" class="tabular"></tbody>
        </table>
      </div>
    </div>

    <!-- NMFC callout -->
    <div class="mt-4 flex items-start gap-3 rounded-lg border border-[var(--color-warning)]/40 bg-[var(--color-warning-bg)] px-4 py-3 text-[13px] text-[var(--color-text)]">
      <svg class="mt-0.5 w-4 h-4 shrink-0 text-[var(--color-warning)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
      <div>
        <strong>Density-based estimate.</strong> If your commodity has an assigned NMFC item number, that item governs your class regardless of density. Confirm with your carrier or broker before shipping. <a href="/nmfc-codes-explained" class="underline underline-offset-2">Learn more →</a>
      </div>
    </div>

    <!-- Results grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-6">

      <!-- Aggregate -->
      <div class="lg:col-span-1 card p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)]">Shipment totals</span>
          <span class="badge">Not billed class</span>
        </div>
        <div class="space-y-3">
          <div>
            <div class="text-[11px] text-[var(--color-text-subtle)] uppercase tracking-wider">Aggregate density</div>
            <div id="agg-density" class="text-2xl font-semibold tabular text-[var(--color-text)] mt-0.5">—</div>
          </div>
          <div class="flex justify-between items-baseline pt-3 border-t border-[var(--color-border)]">
            <span class="text-[13px] text-[var(--color-text-muted)]">Aggregate class</span>
            <span id="agg-class" class="text-lg font-medium tabular text-[var(--color-text)]">—</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-[13px] text-[var(--color-text-muted)]">Total weight</span>
            <span id="agg-weight" class="text-[13px] font-medium tabular text-[var(--color-text)]">—</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-[13px] text-[var(--color-text-muted)]">Total volume</span>
            <span id="agg-volume" class="text-[13px] font-medium tabular text-[var(--color-text)]">—</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-[13px] text-[var(--color-text-muted)]">Linear feet <span class="text-[var(--color-text-subtle)]">(96″ trailer)</span></span>
            <span id="agg-linear" class="text-[13px] font-medium tabular text-[var(--color-text)]">—</span>
          </div>
        </div>
      </div>

      <!-- Breakpoint optimizer -->
      <div class="lg:col-span-2 card p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)]">Breakpoint optimizer · line 1</span>
          <span class="badge">Cheaper &amp; risk</span>
        </div>
        <div id="bp-output" class="text-[14px] text-[var(--color-text-muted)] leading-relaxed">Enter a line to see options.</div>
      </div>

    </div>

    <!-- Consolidation -->
    <div class="mt-4" id="consolidation-block" hidden>
      <div class="card p-5 border-[var(--color-success)]/40 bg-[var(--color-success-bg)]">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-[var(--color-success)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-success)]">Consolidation opportunity</span>
        </div>
        <div id="consolidation-list" class="text-[14px] text-[var(--color-text)] space-y-2"></div>
      </div>
    </div>

    <!-- Density scale -->
    <div class="mt-6">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)] mb-2">Density position</div>
      <ClassScale id="main-scale" />
    </div>

    <AdSlot size="leaderboard" />

    <article class="space-y-12 text-[var(--color-text)] max-w-3xl">
      <section>
        <h2 class="text-2xl font-semibold tracking-tight mb-4">How to calculate freight class</h2>
        <ol class="space-y-3 text-[var(--color-text-muted)] leading-relaxed">
          <li class="flex gap-3"><span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[12px] font-semibold text-[var(--color-text)]">1</span>Measure the <strong class="text-[var(--color-text)]">outermost extremes</strong> of each handling unit — pallet footprint plus overhang, plus the pallet deck height. Carriers measure what they see; declaring bare box dimensions when it sits on a 48×40 pallet is the single most common source of correction invoices.</li>
          <li class="flex gap-3"><span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[12px] font-semibold text-[var(--color-text)]">2</span>Weigh each unit on a certified scale. Include the pallet, packaging, and dunnage.</li>
          <li class="flex gap-3"><span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[12px] font-semibold text-[var(--color-text)]">3</span>Enter one row per handling unit. Five identical pallets use Qty = 5, not five rows.</li>
          <li class="flex gap-3"><span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[12px] font-semibold text-[var(--color-text)]">4</span>Read the <strong class="text-[var(--color-text)]">per-line class</strong>. That is what your carrier will bill.</li>
          <li class="flex gap-3"><span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[12px] font-semibold text-[var(--color-text)]">5</span>Check the aggregate figure only for cube and linear-foot sanity — not as your billed class.</li>
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight mb-4">The math</h2>
        <pre class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-lg p-4 text-[13px] leading-relaxed font-mono overflow-x-auto"><code>volume (ft³) = (L × W × H in) ÷ 1728
density (lb/ft³) = weight (lb) ÷ volume (ft³)
class = density → standard scale (50 – 500)</code></pre>
        <p class="text-[var(--color-text-muted)] mt-4 leading-relaxed">
          Worked example: a 40×48×48 handling unit at 425 lb. Volume = (40 × 48 × 48) ÷ 1728 = 53.33 ft³. Density = 425 ÷ 53.33 ≈ 7.97 lb/ft³. On the density scale, 7–8 lb/ft³ maps to <strong>Class 125</strong>. To reach the next cheaper class (110), the same box would need to hit 8 lb/ft³ — adding ~2 lb, or shaving about 0.36″ off the height, gets there.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight mb-4">Per-line vs aggregate — why it matters</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Carriers rate each line item on the Bill of Lading separately. Ship two pallets — one dense heavy machinery, one light packaging — and the machinery is billed at (say) class 70 and the packaging at class 250. The average density of the shipment is meaningless for billing.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed mt-3">
          The aggregate density is useful for two things only: checking cubic capacity rules (whether your shipment triggers a minimum charge for low density in a large volume) and estimating linear feet. Most competitor calculators report only the aggregate — which is the wrong number to plan around.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight mb-4">Common mistakes</h2>
        <ul class="space-y-2.5 text-[var(--color-text-muted)]">
          <li class="flex gap-2"><span class="text-[var(--color-error)] shrink-0">×</span>Using the box dimensions instead of the pallet. Toggle "Pallet" on each row.</li>
          <li class="flex gap-2"><span class="text-[var(--color-error)] shrink-0">×</span>Ignoring pallet deck height. A 6″ GMA adds 6″ and shifts your density bucket.</li>
          <li class="flex gap-2"><span class="text-[var(--color-error)] shrink-0">×</span>Confusing NMFC item numbers with density classes. A commodity NMFC item overrides density.</li>
          <li class="flex gap-2"><span class="text-[var(--color-error)] shrink-0">×</span>Using aggregate for per-line billing. The two are almost never the same.</li>
          <li class="flex gap-2"><span class="text-[var(--color-error)] shrink-0">×</span>Assuming smart carrier tools will fix bad declarations. They won't — they'll invoice you.</li>
        </ul>
      </section>
    </article>

    <AdSlot size="rectangle" />

    <FAQ items={faqs} />
    <RelatedTools current="/" />
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { computeShipment, breakpointAnalysis, consolidationOpportunities, linearFeet, inToCm, cmToIn, lbToKg, kgToLb } from '../lib/freight-math.js';
  import { PALLET_PRESETS } from '../data/density-classes.js';

  const state = {
    units: 'imperial',
    lines: /** @type {any[]} */ ([]),
  };

  const defaultLine = () => ({
    qty: 1, itemL: 48, itemW: 40, itemH: 48, unitWeight: 500,
    palletized: false, palletKey: 'gma-48x40', palletDeckH: 6, overhangL: 0, overhangW: 0,
  });

  const $ = (id) => document.getElementById(id);
  const body = $('lines-body');

  function toImperialLine(line) {
    if (state.units === 'imperial') return line;
    return {
      ...line,
      itemL: cmToIn(line.itemL), itemW: cmToIn(line.itemW), itemH: cmToIn(line.itemH),
      unitWeight: kgToLb(line.unitWeight),
      palletDeckH: cmToIn(line.palletDeckH),
      overhangL: cmToIn(line.overhangL), overhangW: cmToIn(line.overhangW),
    };
  }

  function fmt(n, d = 2) {
    if (!isFinite(n)) return '—';
    return n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  function renderRows() {
    body.innerHTML = '';
    state.lines.forEach((ln, idx) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-[var(--color-border)] last:border-b-0';
      tr.innerHTML = `
        <td class="px-3 py-2"><input type="number" min="1" step="1" value="${ln.qty}" data-i="${idx}" data-f="qty" style="width:56px" aria-label="Quantity line ${idx+1}"/></td>
        <td class="px-3 py-2"><input type="number" min="0" step="any" value="${ln.itemL}" data-i="${idx}" data-f="itemL" style="width:76px" aria-label="Length line ${idx+1}"/></td>
        <td class="px-3 py-2"><input type="number" min="0" step="any" value="${ln.itemW}" data-i="${idx}" data-f="itemW" style="width:76px" aria-label="Width line ${idx+1}"/></td>
        <td class="px-3 py-2"><input type="number" min="0" step="any" value="${ln.itemH}" data-i="${idx}" data-f="itemH" style="width:76px" aria-label="Height line ${idx+1}"/></td>
        <td class="px-3 py-2"><input type="number" min="0" step="any" value="${ln.unitWeight}" data-i="${idx}" data-f="unitWeight" style="width:90px" aria-label="Weight per unit line ${idx+1}"/></td>
        <td class="px-3 py-2">
          <label class="inline-flex items-center gap-1.5 text-[12px] text-[var(--color-text-muted)]">
            <input type="checkbox" ${ln.palletized ? 'checked' : ''} data-i="${idx}" data-f="palletized" aria-label="Palletized line ${idx+1}" style="width:auto;min-height:0"/> palletized
          </label>
          <select data-i="${idx}" data-f="palletKey" ${ln.palletized ? '' : 'disabled'} style="width:auto;padding:2px 6px;min-height:0;font-size:11px;margin-top:2px">
            ${PALLET_PRESETS.map(p => `<option value="${p.key}" ${p.key === ln.palletKey ? 'selected' : ''}>${p.label}</option>`).join('')}
          </select>
        </td>
        <td class="px-3 py-2 text-right text-[var(--color-text-muted)]" id="dens-${idx}">—</td>
        <td class="px-3 py-2 text-right"><span id="cls-${idx}" class="inline-block px-2 py-0.5 rounded font-medium text-[var(--color-text)]">—</span></td>
        <td class="px-2 py-2 text-right">
          <button type="button" class="w-6 h-6 rounded text-[var(--color-text-subtle)] hover:text-[var(--color-error)] hover:bg-[var(--color-bg-subtle)]" data-remove="${idx}" aria-label="Remove line ${idx+1}">×</button>
        </td>
      `;
      body.appendChild(tr);
    });
  }

  function readInputs() {
    body.querySelectorAll('input[data-f], select[data-f]').forEach((el) => {
      const i = Number(el.dataset.i);
      const f = el.dataset.f;
      if (el.type === 'checkbox') { state.lines[i][f] = el.checked; }
      else if (el.tagName === 'SELECT') {
        state.lines[i][f] = el.value;
        const preset = PALLET_PRESETS.find(p => p.key === el.value);
        if (preset && preset.key !== 'custom') {
          state.lines[i].palletL = preset.l;
          state.lines[i].palletW = preset.w;
          state.lines[i].palletDeckH = preset.deck;
        }
      } else { state.lines[i][f] = Number(el.value); }
    });
  }

  function recompute() {
    const linesForEngine = state.lines.map((ln) => {
      const preset = PALLET_PRESETS.find(p => p.key === ln.palletKey);
      const withPallet = ln.palletized && preset && preset.key !== 'custom' ? {
        ...ln, palletL: preset.l, palletW: preset.w, palletDeckH: preset.deck,
      } : ln;
      return toImperialLine(withPallet);
    });

    let shipment;
    try { shipment = computeShipment(linesForEngine); }
    catch (e) {
      state.lines.forEach((_, i) => {
        const d = $(`dens-${i}`), c = $(`cls-${i}`);
        if (d) d.textContent = '—'; if (c) c.textContent = '—';
      });
      ['agg-density','agg-class','agg-weight','agg-volume','agg-linear'].forEach(id => { $(id).textContent = '—'; });
      $('bp-output').textContent = e.message;
      return;
    }

    shipment.perLine.forEach((p, i) => {
      const d = $(`dens-${i}`), c = $(`cls-${i}`);
      if (d) d.textContent = fmt(p.lineDensity) + ' lb/ft³';
      if (c) c.textContent = String(p.lineClass);
    });

    $('agg-density').textContent = fmt(shipment.aggregateDensity) + ' lb/ft³';
    $('agg-class').textContent = String(shipment.aggregateClass);
    $('agg-weight').textContent = fmt(shipment.totalWeight, 0) + ' lb';
    $('agg-volume').textContent = fmt(shipment.totalVolume) + ' ft³';
    $('agg-linear').textContent = fmt(linearFeet(shipment), 1) + ' ft';

    if (window.updateDensityScale) {
      window.updateDensityScale(shipment.perLine[0].lineDensity, shipment.perLine[0].lineClass);
    }

    const bp = breakpointAnalysis(shipment.perLine[0]);
    let bpHtml = '';
    if (bp.cheaperClass !== null) {
      const t = bp.targets.cheaper;
      const parts = [];
      if (t.weight.delta > 0) parts.push(`add <strong class="text-[var(--color-text)]">${fmt(t.weight.delta, 1)}&nbsp;lb</strong>`);
      if (t.length.delta > 0)  parts.push(`reduce length <strong class="text-[var(--color-text)]">${fmt(t.length.delta, 2)}″</strong>`);
      if (t.width.delta > 0)   parts.push(`reduce width <strong class="text-[var(--color-text)]">${fmt(t.width.delta, 2)}″</strong>`);
      if (t.height.delta > 0)  parts.push(`reduce height <strong class="text-[var(--color-text)]">${fmt(t.height.delta, 2)}″</strong>`);
      bpHtml += `<div class="flex items-start gap-2"><span class="mt-0.5 inline-flex items-center justify-center w-5 h-5 shrink-0 rounded-full bg-[var(--color-success-bg)] text-[var(--color-success)]">↓</span><div><strong class="text-[var(--color-text)]">Reach class ${bp.cheaperClass}:</strong> ${parts.join(' · ') || 'already there'}</div></div>`;
    }
    if (bp.pricierClass !== null) {
      const t = bp.targets.pricier;
      const details = [];
      if (t.weight.delta < 0) details.push(`losing <strong class="text-[var(--color-text)]">${fmt(-t.weight.delta, 1)}&nbsp;lb</strong>`);
      if (t.height.delta < 0)  details.push(`gaining <strong class="text-[var(--color-text)]">${fmt(-t.height.delta, 2)}″</strong> in height`);
      bpHtml += `<div class="mt-3 flex items-start gap-2"><span class="mt-0.5 inline-flex items-center justify-center w-5 h-5 shrink-0 rounded-full bg-[var(--color-warning-bg)] text-[var(--color-warning)]">!</span><div><strong class="text-[var(--color-text)]">Risk of class ${bp.pricierClass}:</strong> ${details.join(' or ') || 'small changes trigger it'}</div></div>`;
    }
    $('bp-output').innerHTML = bpHtml || 'No cheaper class available.';

    const opps = consolidationOpportunities(shipment);
    const block = $('consolidation-block');
    const list = $('consolidation-list');
    if (opps.length === 0) { block.hidden = true; }
    else {
      block.hidden = false;
      list.innerHTML = opps.map(o =>
        `<div>Combine lines <strong>${o.aIndex + 1}</strong> and <strong>${o.bIndex + 1}</strong> onto one pallet (stack ${fmt(o.combinedH, 1)}″) → class <strong class="tabular">${o.combinedClass}</strong> <span class="text-[var(--color-text-muted)]">(vs current worst ${o.savingsVs})</span></div>`
      ).join('');
    }
  }

  function persistToUrl() {
    const params = new URLSearchParams();
    params.set('u', state.units);
    params.set('l', btoa(JSON.stringify(state.lines)));
    history.replaceState(null, '', '?' + params.toString());
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('u')) state.units = params.get('u') || 'imperial';
    if (params.has('l')) {
      try {
        const decoded = JSON.parse(atob(params.get('l')));
        if (Array.isArray(decoded) && decoded.length) state.lines = decoded;
      } catch {}
    }
  }

  function updateUnitLabels() {
    document.querySelectorAll('.unit-len').forEach(el => el.textContent = state.units === 'imperial' ? 'in' : 'cm');
    document.querySelectorAll('.unit-wt').forEach(el => el.textContent = state.units === 'imperial' ? 'lb' : 'kg');
  }

  document.addEventListener('input', (e) => {
    const t = e.target;
    if (t.matches && t.matches('input[data-f], select[data-f]')) {
      readInputs(); renderRows(); recompute(); persistToUrl();
    }
    if (t.matches && t.matches('input[name="units"]')) {
      const nextUnits = t.value;
      if (nextUnits !== state.units) {
        state.lines = state.lines.map(ln => {
          if (nextUnits === 'metric') {
            return { ...ln, itemL: inToCm(ln.itemL), itemW: inToCm(ln.itemW), itemH: inToCm(ln.itemH), unitWeight: lbToKg(ln.unitWeight), palletDeckH: inToCm(ln.palletDeckH), overhangL: inToCm(ln.overhangL), overhangW: inToCm(ln.overhangW) };
          } else {
            return { ...ln, itemL: cmToIn(ln.itemL), itemW: cmToIn(ln.itemW), itemH: cmToIn(ln.itemH), unitWeight: kgToLb(ln.unitWeight), palletDeckH: cmToIn(ln.palletDeckH), overhangL: cmToIn(ln.overhangL), overhangW: cmToIn(ln.overhangW) };
          }
        });
        state.units = nextUnits;
        updateUnitLabels(); renderRows(); recompute(); persistToUrl();
      }
    }
  });

  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!t) return;
    if (t.id === 'add-line') { state.lines.push(defaultLine()); renderRows(); recompute(); persistToUrl(); }
    if (t.id === 'clear-lines') { state.lines = [defaultLine()]; renderRows(); recompute(); persistToUrl(); }
    if (t.dataset && t.dataset.remove !== undefined) {
      state.lines.splice(Number(t.dataset.remove), 1);
      if (state.lines.length === 0) state.lines.push(defaultLine());
      renderRows(); recompute(); persistToUrl();
    }
    if (t.id === 'copy-share') {
      navigator.clipboard.writeText(window.location.href).then(() => { t.textContent = 'Copied'; setTimeout(() => t.textContent = 'Share', 2000); });
    }
    if (t.id === 'copy-summary') {
      const text = buildSummary();
      navigator.clipboard.writeText(text).then(() => { t.textContent = 'Copied'; setTimeout(() => t.textContent = 'Copy summary', 2000); });
    }
    if (t.id === 'print-page') window.print();
  });

  function buildSummary() {
    const lines = state.lines.map((ln, i) => {
      const dEl = document.getElementById('dens-' + i);
      const cEl = document.getElementById('cls-' + i);
      return `Line ${i + 1}: qty ${ln.qty} · ${ln.itemL}×${ln.itemW}×${ln.itemH} ${state.units === 'imperial' ? 'in' : 'cm'} · ${ln.unitWeight} ${state.units === 'imperial' ? 'lb' : 'kg'}/unit · ${dEl?.textContent || '?'} · class ${cEl?.textContent || '?'}`;
    }).join('\n');
    return `Freight shipment summary\n${lines}\n\nAggregate: ${document.getElementById('agg-density').textContent} · class ${document.getElementById('agg-class').textContent} · ${document.getElementById('agg-weight').textContent} · ${document.getElementById('agg-volume').textContent}\n\n(Aggregate is for cube/linear-foot checks — carriers bill per line.)`;
  }

  loadFromUrl();
  if (state.lines.length === 0) state.lines = [defaultLine()];
  document.querySelectorAll('input[name="units"]').forEach((el) => { if (el.value === state.units) el.checked = true; });
  updateUnitLabels();
  renderRows();
  recompute();
</script>
