---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdSlot from '../components/AdSlot.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ClassScale from '../components/ClassScale.astro';

const pageUrl = 'https://freightclassfinder.com/';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Freight Class Calculator",
  "url": pageUrl,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqs = [
  { q: "How do you calculate freight class?",
    a: "Freight class is derived from density: density = weight (lb) ÷ volume (ft³). Volume in ft³ = (length × width × height in inches) ÷ 1728. Look up the density on the standard density-to-class scale (50–500). Higher density → lower class → lower rate. This tool does the lookup automatically." },
  { q: "How do you calculate freight class for multiple pallets?",
    a: "Carriers classify <strong>per line item</strong> on the Bill of Lading, not by shipment aggregate. Enter each pallet as a separate row and read the per-line class. The aggregate density figure below is useful for cube and linear-foot checks, but it is <em>not</em> your billed class." },
  { q: "What is the formula for freight density?",
    a: "Density (lb/ft³) = weight in pounds ÷ volume in cubic feet. Volume in cubic feet = (L × W × H in inches) ÷ 1728. Use the outermost dimensions — pallet footprint plus any overhang, plus pallet deck height. Toggle 'palletized' on each row and the tool applies this automatically." },
  { q: "Why did my carrier reclassify my shipment?",
    a: "Density-based estimates can be overridden if your commodity has a specific NMFC item number, or if the carrier's inspection finds different weight or dimensions than what you declared on the Bill of Lading. Reclassification produces a correction invoice weeks after delivery. This tool gives you the density estimate; your carrier or broker confirms the assigned NMFC item." },
  { q: "How can I lower my freight class?",
    a: "Increase density: pack tighter, use a smaller pallet if the load allows, or consolidate multiple lightweight lines onto one pallet. The breakpoint optimizer below shows, for each line, the smallest change (add weight, or reduce a dimension) that would land you in the next cheaper class." },
  { q: "What is a good freight class?",
    a: "\"Good\" is whatever accurately reflects your actual density. Under-declaring a class produces a correction invoice; over-declaring pays more than you need. The goal is an honest measurement — pallet dimensions, actual weight — that matches what the carrier will observe on its scale and cube meter." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '') }
  }))
};
---
<BaseLayout
  title="Freight Class Calculator – Multi-Pallet, Pallet-Aware, Free"
  description="Free freight class calculator with multi-pallet support, pallet-aware dimensions, and a breakpoint optimizer. Per-line and aggregate density, class 50–500. No signup."
  canonical={pageUrl}
  schema={[webAppSchema, faqSchema]}
>
  <SiteHeader current="/" />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">

    <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-2">Freight Class Calculator</h1>
    <p class="text-[var(--color-text-muted)] mb-6">
      Enter each pallet or handling unit as a row. Get per-line freight class (what your carrier actually bills), shipment totals, and a breakpoint optimizer that tells you how close you are to a cheaper class — in either direction.
    </p>

    <!-- Unit toggle -->
    <div class="flex flex-wrap items-center gap-4 mb-4 text-sm">
      <fieldset class="flex items-center gap-2">
        <legend class="sr-only">Units</legend>
        <label class="text-[var(--color-text-muted)]">Units:</label>
        <label class="inline-flex items-center gap-1"><input type="radio" name="units" value="imperial" checked /> in / lb</label>
        <label class="inline-flex items-center gap-1"><input type="radio" name="units" value="metric" /> cm / kg</label>
      </fieldset>
    </div>

    <!-- Line items table -->
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="lines-table">
          <thead class="bg-[var(--color-bg-subtle)] text-[var(--color-text-muted)]">
            <tr>
              <th class="text-left p-2 font-medium">Qty</th>
              <th class="text-left p-2 font-medium">L <span class="unit-len">in</span></th>
              <th class="text-left p-2 font-medium">W <span class="unit-len">in</span></th>
              <th class="text-left p-2 font-medium">H <span class="unit-len">in</span></th>
              <th class="text-left p-2 font-medium">Wt/unit <span class="unit-wt">lb</span></th>
              <th class="text-left p-2 font-medium">Pallet</th>
              <th class="text-right p-2 font-medium">Density</th>
              <th class="text-right p-2 font-medium">Class</th>
              <th class="p-2"></th>
            </tr>
          </thead>
          <tbody id="lines-body"></tbody>
        </table>
      </div>
      <div class="p-3 border-t border-[var(--color-border)] flex flex-wrap gap-2 items-center">
        <button id="add-line" type="button" class="px-3 py-1.5 rounded-md bg-[var(--color-accent)] text-white text-sm font-medium hover:bg-[var(--color-accent-hover)]" style="min-height:36px">+ Add line</button>
        <button id="clear-lines" type="button" class="px-3 py-1.5 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]" style="min-height:36px">Clear</button>
        <button id="copy-summary" type="button" class="px-3 py-1.5 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] ml-auto" style="min-height:36px">Copy summary</button>
        <button id="copy-share" type="button" class="px-3 py-1.5 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]" style="min-height:36px">Copy shareable link</button>
        <button id="print-page" type="button" class="px-3 py-1.5 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]" style="min-height:36px">Print</button>
      </div>
    </div>

    <!-- Density-vs-NMFC callout: persistent, near result -->
    <div class="mt-4 rounded-md border-l-4 border-[var(--color-warning)] bg-[var(--color-bg-subtle)] px-4 py-3 text-sm text-[var(--color-text)]">
      <strong>Density-based estimate.</strong> If your commodity has an assigned NMFC item number, that item governs your class regardless of density. Confirm with your carrier or broker before shipping. This tool does not reproduce the NMFC database.
    </div>

    <!-- Results -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-result-bg)] p-5">
        <div class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide mb-1">Shipment totals — not your billed class</div>
        <div class="flex items-baseline justify-between gap-3">
          <span class="text-sm text-[var(--color-text-muted)]">Aggregate density</span>
          <span id="agg-density" class="text-xl font-semibold text-[var(--color-text)]">—</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 mt-2">
          <span class="text-sm text-[var(--color-text-muted)]">Aggregate class (cube check)</span>
          <span id="agg-class" class="text-xl font-semibold text-[var(--color-text)]">—</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 mt-2">
          <span class="text-sm text-[var(--color-text-muted)]">Total weight</span>
          <span id="agg-weight" class="text-sm font-medium text-[var(--color-text)]">—</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 mt-1">
          <span class="text-sm text-[var(--color-text-muted)]">Total volume</span>
          <span id="agg-volume" class="text-sm font-medium text-[var(--color-text)]">—</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 mt-1">
          <span class="text-sm text-[var(--color-text-muted)]">Linear feet (96″ trailer)</span>
          <span id="agg-linear" class="text-sm font-medium text-[var(--color-text)]">—</span>
        </div>
      </div>

      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
        <div class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide mb-1">Breakpoint optimizer — first line</div>
        <div id="bp-output" class="text-sm text-[var(--color-text-muted)]">Enter a line to see options.</div>
      </div>
    </div>

    <!-- Consolidation opportunities -->
    <div class="mt-4" id="consolidation-block" hidden>
      <div class="rounded-lg border border-[var(--color-success)] bg-[var(--color-bg-subtle)] p-4">
        <div class="text-xs uppercase tracking-wide text-[var(--color-success)] font-semibold mb-2">Consolidation opportunity</div>
        <div id="consolidation-list" class="text-sm text-[var(--color-text)] space-y-2"></div>
      </div>
    </div>

    <!-- Density scale -->
    <div class="mt-6">
      <ClassScale id="main-scale" />
    </div>

    <AdSlot size="leaderboard" />

    <article class="prose-section space-y-8 text-[var(--color-text)]">
      <section>
        <h2 class="text-2xl font-semibold mb-3">How to Calculate Freight Class</h2>
        <ol class="list-decimal list-inside space-y-2 text-[var(--color-text-muted)] leading-relaxed">
          <li>Measure the <strong>outermost extremes</strong> of each handling unit — pallet footprint plus any overhang, plus the pallet deck height. Carriers measure what they see; declaring the bare box dimensions when it sits on a 48×40 pallet is the single most common source of correction invoices.</li>
          <li>Weigh each unit on a certified scale. Include the pallet, packaging, and dunnage.</li>
          <li>Enter one row per handling unit. If you have five identical pallets, use Qty = 5 rather than five rows.</li>
          <li>Read the <strong>per-line class</strong>. That is what your carrier will bill.</li>
          <li>Check the aggregate figure only for cube and linear-foot sanity — not as your billed class.</li>
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">The Math</h2>
        <div class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-lg p-4 font-mono text-sm mb-3">
          Volume (ft³) = (L × W × H in inches) ÷ 1728<br/>
          Density (lb/ft³) = Weight (lb) ÷ Volume (ft³)<br/>
          Class = density → published density scale (50–500)
        </div>
        <p class="text-[var(--color-text-muted)]">
          Worked example: a 40×48×48 shipping unit at 425 lb. Volume = (40 × 48 × 48) ÷ 1728 = 53.33 ft³. Density = 425 ÷ 53.33 ≈ 7.97 lb/ft³. On the density scale, 7–8 lb/ft³ maps to <strong>Class 125</strong>. To reach the next cheaper class (110), the same box would need to hit 8 lb/ft³ — adding ~2 lb, or shaving about 0.36″ off the height, gets there.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">Per-line vs Aggregate — Why It Matters</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Carriers rate each line item on the Bill of Lading separately. If you ship two pallets — one dense heavy machinery, one light packaging — the machinery is billed at (say) class 70 and the packaging at class 250. The average density of the shipment is meaningless for billing.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed mt-2">
          The aggregate density is useful for two things only: checking cubic capacity rules (whether your shipment triggers a minimum charge for low density in a large volume) and estimating linear feet (whether the shipment triggers a linear-foot rule). Most competitor calculators report only the aggregate — which is the wrong number to plan around.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-3">Common Mistakes</h2>
        <ul class="space-y-2 text-[var(--color-text-muted)]">
          <li><strong>Using the box dimensions instead of the pallet.</strong> Carriers measure the whole unit as it sits on the trailer. Toggle 'Pallet' on each row.</li>
          <li><strong>Ignoring pallet deck height.</strong> A 6″ GMA pallet adds 6″ to your height and shifts your density.</li>
          <li><strong>Confusing NMFC item numbers with density classes.</strong> A commodity NMFC item overrides density. If your product has a listed item, use that.</li>
          <li><strong>Using aggregate for per-line billing.</strong> The two figures are almost never the same and carriers bill per line.</li>
          <li><strong>Assuming smart carrier tools will fix bad declarations.</strong> They won't — they'll issue a reclassification invoice.</li>
        </ul>
      </section>
    </article>

    <AdSlot size="rectangle" />

    <FAQ items={faqs} />
    <RelatedTools current="/" />
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { computeShipment, breakpointAnalysis, consolidationOpportunities, linearFeet, inToCm, cmToIn, lbToKg, kgToLb } from '../lib/freight-math.js';
  import { PALLET_PRESETS } from '../data/density-classes.js';

  const state = {
    units: 'imperial',
    lines: /** @type {any[]} */ ([]),
  };

  const defaultLine = () => ({
    qty: 1, itemL: 48, itemW: 40, itemH: 48, unitWeight: 500,
    palletized: false, palletKey: 'gma-48x40', palletDeckH: 6, overhangL: 0, overhangW: 0,
    desc: '',
  });

  const $ = (id) => document.getElementById(id);
  const body = $('lines-body');

  function toImperialLine(line) {
    if (state.units === 'imperial') return line;
    return {
      ...line,
      itemL: cmToIn(line.itemL),
      itemW: cmToIn(line.itemW),
      itemH: cmToIn(line.itemH),
      unitWeight: kgToLb(line.unitWeight),
      palletDeckH: cmToIn(line.palletDeckH),
      overhangL: cmToIn(line.overhangL),
      overhangW: cmToIn(line.overhangW),
    };
  }

  function fmt(n, d = 2) {
    if (!isFinite(n)) return '—';
    return n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  function renderRows() {
    body.innerHTML = '';
    state.lines.forEach((ln, idx) => {
      const tr = document.createElement('tr');
      tr.className = 'border-t border-[var(--color-border)]';
      tr.innerHTML = `
        <td class="p-2"><input type="number" min="1" step="1" value="${ln.qty}" data-i="${idx}" data-f="qty" style="width:64px"/></td>
        <td class="p-2"><input type="number" min="0" step="any" value="${ln.itemL}" data-i="${idx}" data-f="itemL" style="width:80px"/></td>
        <td class="p-2"><input type="number" min="0" step="any" value="${ln.itemW}" data-i="${idx}" data-f="itemW" style="width:80px"/></td>
        <td class="p-2"><input type="number" min="0" step="any" value="${ln.itemH}" data-i="${idx}" data-f="itemH" style="width:80px"/></td>
        <td class="p-2"><input type="number" min="0" step="any" value="${ln.unitWeight}" data-i="${idx}" data-f="unitWeight" style="width:96px"/></td>
        <td class="p-2">
          <label class="inline-flex items-center gap-1 text-xs">
            <input type="checkbox" ${ln.palletized ? 'checked' : ''} data-i="${idx}" data-f="palletized"/> yes
          </label>
          <select data-i="${idx}" data-f="palletKey" class="text-xs mt-1" ${ln.palletized ? '' : 'disabled'} style="width:auto;padding:2px 4px;min-height:0">
            ${PALLET_PRESETS.map(p => `<option value="${p.key}" ${p.key === ln.palletKey ? 'selected' : ''}>${p.label}</option>`).join('')}
          </select>
        </td>
        <td class="p-2 text-right" id="dens-${idx}">—</td>
        <td class="p-2 text-right font-semibold" id="cls-${idx}">—</td>
        <td class="p-2"><button type="button" class="text-xs text-[var(--color-error)]" data-remove="${idx}">×</button></td>
      `;
      body.appendChild(tr);
    });
  }

  function readInputs() {
    body.querySelectorAll('input[data-f], select[data-f]').forEach((el) => {
      const i = Number(el.dataset.i);
      const f = el.dataset.f;
      if (el.type === 'checkbox') {
        state.lines[i][f] = el.checked;
      } else if (el.tagName === 'SELECT') {
        state.lines[i][f] = el.value;
        // Sync pallet dims from preset.
        const preset = PALLET_PRESETS.find(p => p.key === el.value);
        if (preset && preset.key !== 'custom') {
          state.lines[i].palletL = preset.l;
          state.lines[i].palletW = preset.w;
          state.lines[i].palletDeckH = preset.deck;
        }
      } else {
        state.lines[i][f] = Number(el.value);
      }
    });
  }

  function recompute() {
    // Convert to imperial for the engine.
    const linesForEngine = state.lines.map((ln) => {
      const preset = PALLET_PRESETS.find(p => p.key === ln.palletKey);
      const withPallet = ln.palletized && preset && preset.key !== 'custom' ? {
        ...ln,
        palletL: preset.l, palletW: preset.w, palletDeckH: preset.deck,
      } : ln;
      return toImperialLine(withPallet);
    });

    let shipment;
    try {
      shipment = computeShipment(linesForEngine);
    } catch (e) {
      state.lines.forEach((_, i) => {
        $(`dens-${i}`) && ($(`dens-${i}`).textContent = '—');
        $(`cls-${i}`) && ($(`cls-${i}`).textContent = '—');
      });
      $('agg-density').textContent = '—';
      $('agg-class').textContent = '—';
      $('agg-weight').textContent = '—';
      $('agg-volume').textContent = '—';
      $('agg-linear').textContent = '—';
      $('bp-output').textContent = e.message;
      return;
    }

    shipment.perLine.forEach((p, i) => {
      const densCell = $(`dens-${i}`);
      const clsCell = $(`cls-${i}`);
      if (densCell) densCell.textContent = fmt(p.lineDensity) + ' lb/ft³';
      if (clsCell) clsCell.textContent = String(p.lineClass);
    });

    $('agg-density').textContent = fmt(shipment.aggregateDensity) + ' lb/ft³';
    $('agg-class').textContent = String(shipment.aggregateClass);
    $('agg-weight').textContent = fmt(shipment.totalWeight, 0) + ' lb';
    $('agg-volume').textContent = fmt(shipment.totalVolume) + ' ft³';
    $('agg-linear').textContent = fmt(linearFeet(shipment), 1) + ' ft';

    if (window.updateDensityScale) {
      window.updateDensityScale(shipment.perLine[0].lineDensity, shipment.perLine[0].lineClass);
    }

    // Breakpoint on first line.
    const bp = breakpointAnalysis(shipment.perLine[0]);
    let bpHtml = '';
    if (bp.cheaperClass !== null) {
      const t = bp.targets.cheaper;
      const parts = [];
      if (t.weight.delta > 0) parts.push(`add <strong>${fmt(t.weight.delta, 1)} lb</strong>`);
      if (t.length.delta > 0)  parts.push(`reduce length by <strong>${fmt(t.length.delta, 2)}″</strong>`);
      if (t.width.delta > 0)   parts.push(`reduce width by <strong>${fmt(t.width.delta, 2)}″</strong>`);
      if (t.height.delta > 0)  parts.push(`reduce height by <strong>${fmt(t.height.delta, 2)}″</strong>`);
      bpHtml += `<p><strong>To reach class ${bp.cheaperClass} (cheaper):</strong> ${parts.join(' · ') || 'already there'}</p>`;
    }
    if (bp.pricierClass !== null) {
      const t = bp.targets.pricier;
      const details = [];
      if (t.weight.delta < 0) details.push(`losing <strong>${fmt(-t.weight.delta, 1)} lb</strong>`);
      if (t.height.delta < 0)  details.push(`gaining <strong>${fmt(-t.height.delta, 2)}″</strong> in height`);
      bpHtml += `<p class="mt-2 text-[var(--color-warning)]"><strong>Reclassification risk:</strong> falls into class ${bp.pricierClass} on ${details.join(' or ') || 'small changes'}.</p>`;
    }
    $('bp-output').innerHTML = bpHtml || 'No cheaper class available.';

    // Consolidation
    const opps = consolidationOpportunities(shipment);
    const block = $('consolidation-block');
    const list = $('consolidation-list');
    if (opps.length === 0) {
      block.hidden = true;
    } else {
      block.hidden = false;
      list.innerHTML = opps.map(o =>
        `<div>Combine lines ${o.aIndex + 1} and ${o.bIndex + 1} onto one pallet (stack ${fmt(o.combinedH, 1)}″) → class <strong>${o.combinedClass}</strong> vs current worst class ${o.savingsVs}.</div>`
      ).join('');
    }
  }

  function persistToUrl() {
    const params = new URLSearchParams();
    params.set('u', state.units);
    params.set('l', btoa(JSON.stringify(state.lines)));
    history.replaceState(null, '', '?' + params.toString());
  }

  function loadFromUrl() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('u')) state.units = params.get('u') || 'imperial';
    if (params.has('l')) {
      try {
        const decoded = JSON.parse(atob(params.get('l')));
        if (Array.isArray(decoded) && decoded.length) state.lines = decoded;
      } catch {}
    }
  }

  function updateUnitLabels() {
    document.querySelectorAll('.unit-len').forEach(el => el.textContent = state.units === 'imperial' ? 'in' : 'cm');
    document.querySelectorAll('.unit-wt').forEach(el => el.textContent = state.units === 'imperial' ? 'lb' : 'kg');
  }

  document.addEventListener('input', (e) => {
    const t = e.target;
    if (t.matches && t.matches('input[data-f], select[data-f]')) {
      readInputs();
      renderRows();
      recompute();
      persistToUrl();
    }
    if (t.matches && t.matches('input[name="units"]')) {
      // Convert existing values so a round-trip is lossless.
      const nextUnits = t.value;
      if (nextUnits !== state.units) {
        state.lines = state.lines.map(ln => {
          if (nextUnits === 'metric') {
            return { ...ln, itemL: inToCm(ln.itemL), itemW: inToCm(ln.itemW), itemH: inToCm(ln.itemH), unitWeight: lbToKg(ln.unitWeight), palletDeckH: inToCm(ln.palletDeckH), overhangL: inToCm(ln.overhangL), overhangW: inToCm(ln.overhangW) };
          } else {
            return { ...ln, itemL: cmToIn(ln.itemL), itemW: cmToIn(ln.itemW), itemH: cmToIn(ln.itemH), unitWeight: kgToLb(ln.unitWeight), palletDeckH: cmToIn(ln.palletDeckH), overhangL: cmToIn(ln.overhangL), overhangW: cmToIn(ln.overhangW) };
          }
        });
        state.units = nextUnits;
        updateUnitLabels();
        renderRows();
        recompute();
        persistToUrl();
      }
    }
  });

  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!t) return;
    if (t.id === 'add-line') { state.lines.push(defaultLine()); renderRows(); recompute(); persistToUrl(); }
    if (t.id === 'clear-lines') { state.lines = [defaultLine()]; renderRows(); recompute(); persistToUrl(); }
    if (t.dataset && t.dataset.remove !== undefined) {
      state.lines.splice(Number(t.dataset.remove), 1);
      if (state.lines.length === 0) state.lines.push(defaultLine());
      renderRows(); recompute(); persistToUrl();
    }
    if (t.id === 'copy-share') {
      navigator.clipboard.writeText(window.location.href).then(() => { t.textContent = 'Link copied!'; setTimeout(() => t.textContent = 'Copy shareable link', 2000); });
    }
    if (t.id === 'copy-summary') {
      const text = buildSummary();
      navigator.clipboard.writeText(text).then(() => { t.textContent = 'Copied!'; setTimeout(() => t.textContent = 'Copy summary', 2000); });
    }
    if (t.id === 'print-page') window.print();
  });

  function buildSummary() {
    const lines = state.lines.map((ln, i) => {
      const dEl = document.getElementById('dens-' + i);
      const cEl = document.getElementById('cls-' + i);
      return `Line ${i + 1}: qty ${ln.qty} · ${ln.itemL}×${ln.itemW}×${ln.itemH} ${state.units === 'imperial' ? 'in' : 'cm'} · ${ln.unitWeight} ${state.units === 'imperial' ? 'lb' : 'kg'}/unit · ${dEl?.textContent || '?'} · class ${cEl?.textContent || '?'}`;
    }).join('\n');
    return `Freight shipment summary\n${lines}\n\nAggregate: ${document.getElementById('agg-density').textContent} · class ${document.getElementById('agg-class').textContent} · ${document.getElementById('agg-weight').textContent} · ${document.getElementById('agg-volume').textContent}\n\n(Aggregate is for cube/linear-foot checks — carriers bill per line.)`;
  }

  // Init
  loadFromUrl();
  if (state.lines.length === 0) state.lines = [defaultLine()];
  // Reflect units radio
  document.querySelectorAll('input[name="units"]').forEach((el) => { if (el.value === state.units) el.checked = true; });
  updateUnitLabels();
  renderRows();
  recompute();
</script>
